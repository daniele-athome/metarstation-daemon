<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="utf-8">
<title>Meteo aviosuperficie - 800x600 e-ink</title>
<!--
  Template Jinja2. Il template non calcola nulla: riceve stringhe gia' formattate
  e un paio di rotazioni in gradi. Vedi render.py per il view model.

  Filtro 'dash': sostituisce None e stringa vuota con '--'. NON usare il filtro
  'default' di Jinja con boolean=true: considererebbe mancante anche lo zero
  (vento 0 km/h, copertura 0%, temperatura 0.0).
-->
<style>
  @page { size: 800px 600px; margin: 0; }
  :root{
    --ink:      #000000;
    --ink-soft: #3d3d3d;
    --mid:      #8a8a8a;
    --rule:     #c8c8c8;
    --band:     #e6e6e6;
    --paper:    #ffffff;

    --pad: 22px;
  }

  html,body{margin:0;padding:0;background:var(--paper);}
  body{
    font-family:"DejaVu Sans Condensed","DejaVu Sans","Liberation Sans",Arial,sans-serif;
    color:var(--ink);
    -webkit-font-smoothing:none;
    font-variant-numeric:tabular-nums;
  }
  /* Le quattro fasce sono in flusso normale, NON flex: in WeasyPrint i flex
     annidati moltiplicano i passaggi di layout (misurato: ~6x piu' lento).
     Altezze fisse, con box-sizing:border-box (bordi inclusi):
       head 58 + verdict 92 + body 374 + ephem 76 = 600                     */
  .board{
    width:800px;height:600px;overflow:hidden;
  }

  /* ---------- intestazione ---------- */
  .head{
    height:58px;
    display:flex;align-items:center;
    padding:0 var(--pad);
    border-bottom:2px solid var(--ink);
    box-sizing:border-box;
  }
  .head-inner{
    flex:1 1 auto;
    display:flex;align-items:baseline;justify-content:space-between;
  }
  .site{font-size:26px;font-weight:700;letter-spacing:.01em;line-height:1;white-space:nowrap;}
  .when{display:flex;align-items:baseline;gap:16px;flex:0 0 auto;white-space:nowrap;}
  .when .date{font-size:19px;color:var(--ink-soft);line-height:1;}
  .when .clock{font-size:34px;font-weight:700;line-height:1;}

  /* ---------- fascia verdetto ---------- */
  .verdict{
    height:92px;
    background:var(--ink);color:var(--paper);
    display:flex;align-items:center;justify-content:space-between;
    padding:0 var(--pad);box-sizing:border-box;
  }
  .verdict .call{font-size:46px;font-weight:700;line-height:1;}
  .verdict .sky{
    font-size:24px;text-align:right;line-height:1.25;color:#dedede;
    max-width:300px;
  }

  /* ---------- corpo ---------- */
  .body{height:374px;display:flex;}

  /* vento */
  .wind{
    flex:0 0 288px;box-sizing:border-box;
    border-right:2px solid var(--ink);
    padding:14px 0 0;
    display:flex;flex-direction:column;align-items:center;
  }
  .rose{display:block;}
  .wind .read{
    margin-top:2px;text-align:center;
  }
  .wind .speed{font-size:52px;font-weight:700;line-height:1;}
  .wind .speed span{font-size:22px;font-weight:400;margin-left:6px;}
  .wind .from{font-size:20px;color:var(--ink-soft);margin-top:4px;}
  .wind .gust{
    font-size:21px;font-weight:700;margin-top:8px;
    padding:3px 12px;background:var(--band);
    border:2px solid var(--ink);
  }

  /* griglia valori */
  .vals{
    flex:1 1 auto;box-sizing:border-box;
  }
  .row{display:flex;height:186.5px;}   /* 186.5 + (186.5 + 1 di bordo) = 374 */
  .row + .row{border-top:1px solid var(--rule);}
  .cell{
    flex:1 1 0;box-sizing:border-box;
    padding:12px 16px;
    display:flex;flex-direction:column;justify-content:center;
  }
  .cell + .cell{border-left:1px solid var(--rule);}
  .cell .k{font-size:15px;color:var(--ink-soft);margin-bottom:4px;white-space:nowrap;}
  .cell .v{font-size:40px;font-weight:700;line-height:1;}
  .cell .v u{font-size:18px;font-weight:400;text-decoration:none;margin-left:4px;}
  .cell.lead .v{font-size:60px;}
  .cell.lead .k{font-size:24px;margin-bottom:8px;}
  .cell.lead{flex:1.35 1 0;}

  /* ---------- effemeridi ---------- */
  .ephem{
    height:76px;box-sizing:border-box;
    background:var(--band);
    border-top:2px solid var(--ink);
    display:flex;align-items:center;
    padding:0 var(--pad);
  }
  .ephem .item{flex:1 1 0;}
  .ephem .k{font-size:14px;color:var(--ink-soft);white-space:nowrap;}
  .ephem .v{font-size:26px;font-weight:700;line-height:1.15;}
  .ephem .stamp{
    flex:0 0 auto;text-align:right;font-size:14px;color:var(--ink-soft);line-height:1.35;
  }
</style>
</head>
<body>
<div class="board">

  <div class="head">
    <div class="head-inner">
      <div class="site">{{ site }}</div>
      <div class="when">
        <div class="date" id="date">{{ date }}</div>
        <div class="clock" id="clock">{{ clock }}</div>
      </div>
    </div>
  </div>

  <div class="verdict">
    <div class="call" id="verdict">{{ verdict | dash }}</div>
    <div class="sky" id="sky">{{ sky | dash }}</div>
  </div>

  <div class="body">

    <div class="wind">
      <svg class="rose" width="232" height="232" viewBox="0 0 232 232">
        <!-- Coordinate in pixel reali: viewBox = dimensione a schermo (scala 1:1),
             cosi' gli stroke-width dichiarati sono i pixel che finiscono nel PNG.
             Centro della rosa: (116, 116). -->

        <!-- pista: asse lungo la QFU, disegnata sotto la rosa -->
        <rect x="101" y="12" width="30" height="208"
              fill="#e6e6e6" stroke="#000" stroke-width="2"
              transform="rotate({{ runway.rotation }} 116 116)"/>
        <!-- cerchio esterno -->
        <circle cx="116" cy="116" r="96.5" fill="none" stroke="#000" stroke-width="3"/>
        <circle cx="116" cy="116" r="65"   fill="none" stroke="#c8c8c8" stroke-width="1"/>

        <!-- tacche cardinali -->
        <g stroke="#000" stroke-width="3">
          <line x1="116"   y1="19.5"  x2="116" y2="40"/>
          <line x1="212.5" y1="116"   x2="192" y2="116"/>
          <line x1="116"   y1="212.5" x2="116" y2="192"/>
          <line x1="19.5"  y1="116"   x2="40"  y2="116"/>
        </g>
        <!-- tacche intermedie ogni 30 gradi -->
        <g stroke="#8a8a8a" stroke-width="2">
          <line x1="164.26" y1="32.48"  x2="158.69" y2="41.76"/>
          <line x1="199.52" y1="67.74"  x2="190.24" y2="73.31"/>
          <line x1="199.52" y1="164.26" x2="190.24" y2="158.69"/>
          <line x1="164.26" y1="199.52" x2="158.69" y2="190.24"/>
          <line x1="67.74"  y1="199.52" x2="73.31"  y2="190.24"/>
          <line x1="32.48"  y1="164.26" x2="41.76"  y2="158.69"/>
          <line x1="32.48"  y1="67.74"  x2="41.76"  y2="73.31"/>
          <line x1="67.74"  y1="32.48"  x2="73.31"  y2="41.76"/>
        </g>

        <!-- cardinali -->
        <g font-family="DejaVu Sans Condensed, DejaVu Sans, sans-serif" font-size="17.6" font-weight="700" fill="#000" text-anchor="middle">
          <text x="116"   y="14.85">N</text>
          <text x="225.5" y="122.5">E</text>
          <text x="116"   y="230.1">S</text>
          <text x="6.5"   y="122.5">O</text>
        </g>

        <!-- Convenzione aeronautica: la cuspide indica dove va il vento.
             rotation = (direzione_da + 180) mod 360, calcolata nel view model.
             Senza direzione la cuspide non viene disegnata affatto. -->
        {%- if wind.rotation is not none %}
        <g transform="rotate({{ wind.rotation }} 116 116)">
          <path d="M116 51.04 L141.61 175.67 L116 156.74 L90.39 175.67 Z" fill="#000" stroke="#fff" stroke-width="2" stroke-linejoin="miter" stroke-miterlimit="10"/>
        </g>
        {%- endif %}
      </svg>

      <div class="read">
        <div class="speed" id="wind-speed">{{ wind.speed | dash }}<span>km/h</span></div>
        <div class="from" id="wind-dir">{{ wind.dir_text | dash }}</div>
        <div class="gust" id="gust">raffiche {{ wind.gust | dash }} km/h</div>
      </div>
    </div>

    <div class="vals">
      <div class="row">
        <div class="cell lead">
          <div class="k">Temperatura</div>
          <div class="v" id="temp">{{ temp | dash }}<u>&deg;C</u></div>
        </div>
        <div class="cell lead">
          <div class="k">QNH</div>
          <div class="v" id="qnh">{{ qnh | dash }}</div>
        </div>
      </div>
      <div class="row">
        <div class="cell">
          <div class="k">Punto di rugiada</div>
          <div class="v" id="dew">{{ dew | dash }}<u>&deg;C</u></div>
        </div>
        <div class="cell">
          <div class="k">Umidit&agrave;</div>
          <div class="v" id="rh">{{ rh | dash }}<u>%</u></div>
        </div>
        <div class="cell">
          <div class="k">Copertura</div>
          <div class="v" id="clouds">{{ clouds | dash }}<u>%</u></div>
        </div>
        <div class="cell">
          <div class="k">Visibilit&agrave;</div>
          <div class="v" id="vis">{{ vis | dash }}<u>km</u></div>
        </div>
      </div>
    </div>

  </div>

  <div class="ephem">
    <div class="item">
      <div class="k">Alba</div>
      <div class="v" id="sunrise">{{ ephem.sunrise }}</div>
    </div>
    <div class="item">
      <div class="k">Tramonto</div>
      <div class="v" id="sunset">{{ ephem.sunset }}</div>
    </div>
    <div class="item">
      <div class="k">Crepuscolo civile</div>
      <div class="v" id="twilight">{{ ephem.twilight }}</div>
    </div>
    <div class="item">
      <div class="k">Luce residua</div>
      <div class="v" id="daylight">{{ ephem.daylight }}</div>
    </div>
    <div class="stamp">
      rilevazione {{ stamp.observed }}<br>
      aggiornato {{ stamp.updated }}
    </div>
  </div>

</div>
</body>
</html>
