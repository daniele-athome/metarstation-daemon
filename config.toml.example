[collector]
interval_secs = 60
timeout_secs = 30

[[backend]]
module = "ws90.WS90SensorBackend"
#bt_address = "XX:XX:XX:XX:XX:XX"

[webcam]
discovery_interface = "wlan0"
camera_username = "camera_username"
camera_password = "camera_username"
cloud_username = "admin"
cloud_password = "cloud_password"
snapshot_interval_secs = 60
debug = false
quality = "HD"

[frontend]
data_url = "http://localhost:8787/push"
image_url = "http://localhost:8787/image"
api_token = "api_token"
timeout_secs = 10

[dashboard]
image_path = "metar-dashboard-eink.png"
site = "Test Flight Airstrip"
runway_rotation = 140
elevation_ft = 558
